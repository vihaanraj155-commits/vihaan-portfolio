# Copy to .env and edit. Every value below is optional; the API boots with defaults.

ENVIRONMENT=development

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Contact form throttling: max submissions per IP per window.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=3600

# Optional SMTP relay. Leave SMTP_HOST empty to store submissions without emailing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
