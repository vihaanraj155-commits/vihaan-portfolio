# Loaded by `vite build --mode static` (npm run build:static).
#
# A static host runs no backend, so there is nothing for the contact form to post to. "off"
# swaps the form for a mail link instead of shipping a form that always errors. To keep a
# working form, replace this with a third-party form endpoint:
#
#   VITE_CONTACT_ENDPOINT=https://formspree.io/f/your-id
VITE_CONTACT_ENDPOINT=off
