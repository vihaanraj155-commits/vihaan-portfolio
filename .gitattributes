# Shell scripts must keep LF endings: a CRLF shebang line gives "exec format error" when the
# container starts, with a message that points nowhere near the cause.
*.sh text eol=lf

# The host reads _redirects verbatim. A CI clone gets LF anyway, but a drag-and-drop deploy
# of a locally built dist/ would carry this file's Windows CRLF straight to the host, so pin
# it rather than depend on how the bundle was produced.
_redirects text eol=lf
